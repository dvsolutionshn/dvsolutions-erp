[Unit]
Description=DV Solutions - automatizaciones del CRM
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=dvsolutions
Group=dvsolutions
WorkingDirectory=__APP_DIR__
EnvironmentFile=__ENV_FILE__
ExecStart=__PYTHON_BIN__ manage.py procesar_recordatorios_citas

[Install]
WantedBy=multi-user.target
