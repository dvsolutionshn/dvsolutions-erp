DEBUG=False
SECRET_KEY=cambia-esta-clave-por-una-segura
ALLOWED_HOSTS=erp.tudominio.com,www.erp.tudominio.com
CSRF_TRUSTED_ORIGINS=https://erp.tudominio.com,https://www.erp.tudominio.com

DATABASE_URL=postgres://usuario:contrasena@localhost:5432/dvsolutions

TIME_ZONE=America/Tegucigalpa
LANGUAGE_CODE=en-us

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.tudominio.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=notificaciones@tudominio.com
EMAIL_HOST_PASSWORD=contrasena-smtp-o-app-password
DEFAULT_FROM_EMAIL=notificaciones@tudominio.com

# Onix IA (dejar ONIX_ENABLED=false hasta configurar una clave de API valida)
ONIX_ENABLED=false
OPENAI_API_KEY=
ONIX_ALLOWED_COMPANY_SLUGS=demo_1
ONIX_TRIAL_MODE=true
ONIX_TRIAL_MONTHLY_TOKEN_LIMIT=100000
ONIX_MODEL=gpt-5.6-luna
ONIX_REASONING_EFFORT=low
ONIX_TIMEOUT_SECONDS=45
ONIX_MAX_HISTORY_MESSAGES=12
ONIX_MAX_TOOL_ROUNDS=4
ONIX_INPUT_PRICE_PER_MTOK=0.20
ONIX_CACHED_INPUT_PRICE_PER_MTOK=0.02
ONIX_OUTPUT_PRICE_PER_MTOK=1.20
ONIX_MOBILE_TOKEN_DAYS=30
ONIX_MOBILE_MAX_SESSIONS_PER_USER=5
ONIX_MOBILE_LOGIN_MAX_ATTEMPTS=5
ONIX_MOBILE_LOGIN_WINDOW_SECONDS=900
ONIX_MOBILE_MAX_BODY_BYTES=65536
# Genere una clave con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ONIX_CONNECTION_ENCRYPTION_KEY=
# OAuth web de Google. El callback debe registrarse exactamente en Google Cloud.
ONIX_GOOGLE_CLIENT_ID=
ONIX_GOOGLE_CLIENT_SECRET=
ONIX_GOOGLE_REDIRECT_URI=https://erp.tudominio.com/api/onix/mobile/v1/connections/google/callback/
ONIX_GOOGLE_SCOPES=openid,email,profile,https://www.googleapis.com/auth/calendar.events
ONIX_WHATSAPP_ENABLED=false

SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false
